# Base URLs the browser uses to reach the three services. Defaults match the
# Vite dev proxy paths — `/hipki`, `/smt`, and `localhost:8080` are passed
# through `vite.config.ts::server.proxy` so the browser sees same-origin
# requests and bypasses CORS. The HiPKI LocalSignServer in particular does
# not send CORS headers, so a direct `http://localhost:61161` URL will be
# blocked even though the server returns 200.

# go-zkid-verifier base URL. Either keep this absolute (verifier sends CORS
# headers in dev) or set to `/verifier` and use the proxy.
VITE_VERIFIER_BASE_URL=http://localhost:8080

# HiPKI LocalSignServer base URL. The browser opens
# `<VITE_HIPKI_BASE_URL>/popupForm` in a popup window; the popup itself
# is same-origin with the LocalSignServer so its fetches work without
# CORS headers, and we bridge via postMessage. Same code path in dev and
# production — no reverse proxy required.
VITE_HIPKI_BASE_URL=http://localhost:61161

# moica-revocation-smt — proxy by default for the same reason.
VITE_SMT_BASE_URL=/smt

# Default issuer identifier for SMT proof lookups. `g2` = MOICA RSA-2048 CA,
# `g3` = RSA-4096 CA.
VITE_SMT_ISSUER=g2

# Optional: override the upstream targets the proxy forwards to. Useful if
# HiPKI / SMT run on non-default ports.
# VITE_HIPKI_PROXY_TARGET=http://localhost:61161
# VITE_SMT_PROXY_TARGET=http://localhost:3000
# VITE_VERIFIER_PROXY_TARGET=http://localhost:8080
