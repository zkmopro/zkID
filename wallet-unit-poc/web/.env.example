# go-zkid-verifier base URL. Serves POST /challenge and POST /link-verify.
VITE_VERIFIER_BASE_URL=http://localhost:8080

# HiPKI LocalSignServer base URL. Assumes the user has installed and started
# a CORS-enabled HiPKI LocalSignServer on their own machine — the browser
# fetches this directly. HTTPS hosts are subject to the browser's
# mixed-content policy (see README).
VITE_HIPKI_BASE_URL=http://localhost:61161

# moica-revocation-smt base URL.
VITE_SMT_BASE_URL=http://localhost:3000

# Default issuer identifier for SMT proof lookups. `g2` = MOICA RSA-2048 CA,
# `g3` = RSA-4096 CA.
VITE_SMT_ISSUER=g2
